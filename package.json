{
  "name": "image-converter",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "preview": "npm --prefix app run preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:linux": "tauri build --bundles deb,appimage",
    "desktop:build:windows": "tauri build --bundles nsis,msi",
    "desktop:build:macos": "tauri build --bundles dmg --target universal-apple-darwin",
    "test": "npm --prefix app run test",
    "test:watch": "npm --prefix app run test:watch",
    "test:e2e": "npm --prefix app run test:e2e",
    "test:e2e:ui": "npm --prefix app run test:e2e:ui"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "vite": "^7.1.0"
  }
}
