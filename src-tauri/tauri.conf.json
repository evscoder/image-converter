{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "imagemag-converter",
  "version": "1.0.4",
  "identifier": "com.imagemag.imageconverter",
  "build": {
    "beforeDevCommand": "npm --prefix app run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix app run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ImageMAG Converter",
        "width": 1280,
        "height": 900,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "dragDropEnabled": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Пакетный конвертер изображений",
    "longDescription": "Офлайн-конвертер изображений в WebP, JPEG и PNG с пакетной обработкой и изменением размера.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
